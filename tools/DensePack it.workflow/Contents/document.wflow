					<key>Optional</key>
					<true/>
					<key>Types</key>
					<array>
						<string>com.apple.cocoa.string</string>
					</array>
				</dict>
				<key>AMActionVersion</key>
				<string>2.0.3</string>
				<key>AMApplication</key>
				<array>
					<string>Automator</string>
				</array>
				<key>AMParameterProperties</key>
				<dict>
					<key>COMMAND_STRING</key>
					<dict/>
					<key>CheckedForUserDefaultShell</key>
					<dict/>
					<key>inputMethod</key>
					<dict/>
					<key>shell</key>
					<dict/>
					<key>source</key>
					<dict/>
				</dict>
				<key>AMProvides</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Types</key>
					<array>
						<string>com.apple.cocoa.string</string>
					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># DensePack it, a Finder Quick Action for macOS.
#
# This is the macOS version of the Windows right-click entry and of the Linux
# script densepack-file.sh. Finder passes each selected file as an argument.
# The paths are in "$@".
#
# The script uses tools/densepack.py in ~/DensePack, or else in the copy of
# the repo that the plugin install downloads. To use another copy, put the
# full path of its tools/densepack.py in the PACKER line.
#
# The packer writes each image beside its source file, with the name
# &lt;file&gt;.densepack-1.png. Windows and Linux write the same name.

PACKER=""
for p in "$HOME/DensePack/tools/densepack.py" \
         "$HOME/.claude/plugins/marketplaces/densepack-marketplace/tools/densepack.py"; do
  if [ -z "$PACKER" ] &amp;&amp; [ -f "$p" ]; then
    PACKER="$p"
  fi
done

# A Quick Action runs outside a login shell. Its PATH holds neither Homebrew
# prefix. The next line adds the Apple silicon prefix first, then the Intel one.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

# A Quick Action has no terminal. alert sends each message to Notification
# Center. A quote or a line break in the text ends the AppleScript string
# early. alert first changes each line break to a space and removes each quote.
alert() {
  msg=$(printf '%s' "$1" | tr '\n' ' ' | tr -d '"')
  /usr/bin/osascript -e "display notification \"$msg\" with title \"DensePack\""
}

# The plugin saves the path of its Python and keeps Pillow, freetype-py and
# NumPy in its own folder. When both are there, the script uses them, and
# the Quick Action needs no install of its own.
PY=""
SAVED="$HOME/.claude/densepack-state/python-path"
PYLIBS="$HOME/.claude/plugins/data/densepack-densepack-marketplace/pylibs"
if [ -f "$SAVED" ] &amp;&amp; [ -d "$PYLIBS" ]; then
  IFS= read -r PY &lt; "$SAVED"
  if [ -x "$PY" ]; then
    PYTHONPATH="$PYLIBS${PYTHONPATH:+:$PYTHONPATH}"
    export PYTHONPATH
  else
    PY=""
  fi
fi
# Otherwise the first python3 on PATH that is 3.10 or newer. Without the
# Xcode Command Line Tools, /usr/bin/python3 is a stub that opens an install
# window, so the search skips it then. With them, it is 3.9, which fails the
# version test.
if [ -z "$PY" ]; then
  for c in $(which -a python3 2&gt;/dev/null); do
    if [ "$c" = /usr/bin/python3 ] &amp;&amp; ! xcode-select -p &gt;/dev/null 2&gt;&amp;1; then
      continue
    fi
    if "$c" -c 'import sys; sys.exit(sys.version_info &lt; (3, 10))' 2&gt;/dev/null; then
      PY="$c"
      break
    fi
  done
fi
if [ -z "$PY" ]; then
  alert "DensePack found no Python 3.10 or newer. Install the DensePack plugin in Claude Code, or run brew install python, then try again."
  exit 1
fi
if [ -z "$PACKER" ]; then
  alert "Cannot find tools/densepack.py in ~/DensePack or in the plugin download. Put its full path in the PACKER line of this Quick Action."
  exit 1
fi

packed=0
last=""
for f in "$@"; do
  if [ ! -f "$f" ]; then
    continue
  fi
  # The script passes no size. The packer makes the plugin's one page at 17 px
  # unless DENSEPACK_CODE_PX names another number.
  out=$("$PY" "$PACKER" "$f" --out "$f.densepack" 2&gt;&amp;1) || {
    alert "Packing failed. $out"
    exit 1
  }
  packed=$((packed + 1))
  last="$out"
done

if [ "$packed" -eq 0 ]; then
  alert "DensePack packed nothing. It reads files, not folders."
  exit 1
fi
alert "$packed packed. $last"
</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/sh</string>
					<key>source</key>
					<string></string>
				</dict>
				<key>BundleIdentifier</key>
				<string>com.apple.RunShellScript</string>
				<key>CFBundleVersion</key>
				<string>2.0.3</string>
				<key>CanShowSelectedItemsWhenRun</key>
				<false/>
				<key>CanShowWhenRun</key>
				<true/>
				<key>Category</key>
				<array>
					<string>AMCategoryUtilities</string>
				</array>
				<key>Class Name</key>
				<string>RunShellScriptAction</string>
				<key>InputUUID</key>
				<string>0C2D9A31-7E4B-4B0E-9E42-2B5C7A1D3F60</string>
				<key>Keywords</key>
				<array>
					<string>Shell</string>
					<string>Script</string>
					<string>Command</string>
					<string>Run</string>
					<string>Unix</string>
				</array>
				<key>OutputUUID</key>
				<string>7F1E5C28-3A64-45D9-8C13-6E0B9D4A2571</string>
				<key>UUID</key>
				<string>B4A6E093-5D17-42C8-A70F-1C8E36B95D24</string>
				<key>UnlocalizedApplications</key>
				<array>
					<string>Automator</string>
				</array>
				<key>arguments</key>
				<dict/>
				<key>isViewVisible</key>
				<integer>1</integer>
				<key>location</key>
				<string>309.000000:253.000000</string>
				<key>nibPath</key>
				<string>/System/Library/Automator/Run Shell Script.action/Contents/Resources/Base.lproj/main.nib</string>
			</dict>
			<key>isViewVisible</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>connectors</key>
	<dict/>
	<key>workflowMetaData</key>
	<dict>
		<key>applicationBundleIDsByPath</key>
		<dict/>
		<key>applicationPaths</key>
		<array/>
		<key>inputTypeIdentifier</key>
		<string>com.apple.Automator.fileSystemObject</string>
		<key>outputTypeIdentifier</key>
		<string>com.apple.Automator.nothing</string>
		<key>presentationMode</key>
		<integer>11</integer>
		<key>processesInput</key>
		<integer>0</integer>
		<key>serviceApplicationBundleID</key>
		<string>com.apple.finder</string>
		<key>serviceApplicationPath</key>
		<string>/System/Library/CoreServices/Finder.app</string>
		<key>serviceInputTypeIdentifier</key>
		<string>com.apple.Automator.fileSystemObject</string>
		<key>serviceOutputTypeIdentifier</key>
		<string>com.apple.Automator.nothing</string>
		<key>serviceProcessesInput</key>
		<integer>0</integer>
		<key>systemImageName</key>
		<string>NSActionTemplate</string>
		<key>useAutomaticInputType</key>
