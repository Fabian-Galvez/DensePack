					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># DensePack it, a Finder Quick Action for macOS.
#
# This is the macOS twin of the Windows right-click entry and of the Linux
# script densepack-file.sh. Finder passes every selected file as an argument,
# so the paths arrive in "$@".
#
# Edit the PACKER line to the full path of tools/densepack.py in your copy of
# the DensePack repo. That one line is the only thing to change.
#
# Each image lands beside the file it came from, named
# &lt;file&gt;.densepack-1.png, the same name Windows and Linux write.

PACKER="$HOME/DensePack/tools/densepack.py"

# A Quick Action runs outside a login shell, so its PATH holds neither
# Homebrew prefix. Apple silicon first, then Intel.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

# A Quick Action has no terminal, so a message has to reach Notification
# Centre. A quote or a line break inside the text would end the AppleScript
# string early, so both are taken out first.
alert() {
  msg=$(printf '%s' "$1" | tr '\n' ' ' | tr -d '"')
  /usr/bin/osascript -e "display notification \"$msg\" with title \"DensePack\""
}

PY=$(command -v python3 || command -v python || true)
if [ -z "$PY" ]; then
  alert "Python 3 is not installed. Install it, then try again."
  exit 1
fi
if [ ! -f "$PACKER" ]; then
  alert "Cannot find densepack.py at $PACKER. Edit the PACKER line in this Quick Action."
  exit 1
fi

packed=0
last=""
for f in "$@"; do
  if [ ! -f "$f" ]; then
    continue
  fi
  # --pick opens the packer's own three button dialog, which is the same
  # question the Windows "Pick a size..." item asks. With no Tk to draw it the
  # packer falls back to 10 px and says so in the text this alerts with.
  out=$("$PY" "$PACKER" "$f" --pick --out "$f.densepack" 2&gt;&amp;1) || {
    alert "Packing failed. $out"
    exit 1
  }
  packed=$((packed + 1))
  last="$out"
done

if [ "$packed" -eq 0 ]; then
  alert "Nothing was packed. DensePack reads files, not folders."
  exit 1
fi
alert "$packed packed. $last"
</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/sh</string>
					<key>source</key>
					<string></string>
