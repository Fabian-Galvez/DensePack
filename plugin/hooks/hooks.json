{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure_python.sh\" ; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure_python.ps1\" ; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap.py\" ; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap.py\" ; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/session_end.py\" ; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/session_end.py\" ; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent_stop.py\" ; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent_stop.py\" ; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/pointer.py\" ; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/pointer.py\" ; exit $LASTEXITCODE",
            "timeout": 1800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/prompt_card.py\" ; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/prompt_card.py\" ; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/brief_pack.py\" ; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/brief_pack.py\" ; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/brief_pack.py\" ; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/brief_pack.py\" ; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/source_gate.py\" ; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/source_gate.py\" ; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/bash_gate.py\" ; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/bash_gate.py\" ; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/drop_read_gate.py\" ; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/drop_read_gate.py\" ; exit $LASTEXITCODE",
            "timeout": 1800
          },
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/read_gate.py\" ; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/read_gate.py\" ; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/grep_gate.py\" ; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/grep_gate.py\" ; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "exec sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/grep_gate.py\" ; powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.ps1\" \"${CLAUDE_PLUGIN_ROOT}/scripts/run_once.py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/grep_gate.py\" ; exit $LASTEXITCODE"
          }
        ]
      }
    ]
  }
}
